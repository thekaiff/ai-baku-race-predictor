{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" }
  ],

   "functions": {
    "api/index.py": {
      "excludeFiles": "{.git/**,.github/**,.next/**,.vercel/**,.venv/**,node_modules/**,tests/**,docs/**,__pycache__/**,**/*.ipynb}"
        }
     }
  }